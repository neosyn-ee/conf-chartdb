# Dockerfile.dev
FROM node:22-alpine

ARG VITE_OPENAI_API_KEY
ARG VITE_OPENAI_API_ENDPOINT
ARG VITE_LLM_MODEL_NAME
ARG VITE_HIDE_CHARTDB_CLOUD
ARG VITE_DISABLE_ANALYTICS

ENV VITE_OPENAI_API_KEY=${VITE_OPENAI_API_KEY}
ENV VITE_OPENAI_API_ENDPOINT=${VITE_OPENAI_API_ENDPOINT}
ENV VITE_LLM_MODEL_NAME=${VITE_LLM_MODEL_NAME}
ENV VITE_HIDE_CHARTDB_CLOUD=${VITE_HIDE_CHARTDB_CLOUD}
ENV VITE_DISABLE_ANALYTICS=${VITE_DISABLE_ANALYTICS}

WORKDIR /usr/src/app

# Copia package files
COPY package.json package-lock.json ./

# Installa dipendenze
RUN npm ci

# Copia il resto del codice
COPY . .

# Esponi la porta 3000
EXPOSE 4000

# Comando per avviare il dev server
CMD ["npm", "run", "dev:docker"]